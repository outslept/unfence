{
  "name": "unfence",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest --reporter=dot",
    "test:cov": "vitest run --coverage --reporter=dot"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.1"
  },
  "packageManager": "pnpm@10.15.0"
}
